# ─────────────────────────────────────────────────────────────
# DataPilot AI — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Backend (FastAPI) ──
# Strong random key used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at each startup (all sessions
# are invalidated on restart).
DATAPILOT_SECRET_KEY=

# Comma-separated list of allowed frontend origins (CORS).
DATAPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.example.com

# Demo guest mode: 1 = requests without a token see the demo workspace (default),
# 0 = all protected endpoints require a valid JWT.
DATAPILOT_GUEST_MODE=1

# ── Node.js (secondary backend) ──
# JWT signing key. Same guidance as DATAPILOT_SECRET_KEY.
JWT_SECRET=

# Allowed frontend origin for the Express server.
CLIENT_ORIGIN=http://localhost:5173

# Strong password used by the seeded admin account.
DATAPILOT_ADMIN_PASSWORD=

# ── Frontend (Vite) ──
# Optional. First backend base URL the frontend probes.
VITE_API_URL=